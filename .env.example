# ============================================
# Configuration du projet NYC Taxi Pipeline
# ============================================
# Copier ce fichier en .env et remplir les valeurs

# ----- Airflow -----
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# ----- MinIO (Data Lake S3-compatible) -----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=nyc-taxi-lake

# ----- API NYC Open Data (Socrata) -----
# Token optionnel mais conseillé pour éviter le throttling
# Créez-en un gratuitement sur https://data.cityofnewyork.us/
NYC_APP_TOKEN=

# Dataset Yellow Taxi : t29m-gskq (2024)
# Liste : https://data.cityofnewyork.us/browse?q=taxi
NYC_DATASET_ID=t29m-gskq

# ----- Snowflake -----
SNOWFLAKE_ACCOUNT=xxxxx-xxxxx
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=NYC_TAXI
SNOWFLAKE_SCHEMA_RAW=RAW
SNOWFLAKE_SCHEMA_STAGING=STAGING
SNOWFLAKE_SCHEMA_MARTS=MARTS
